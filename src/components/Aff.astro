---
// Affiliate link. Approved programs use the tracking href and show a small
// "affiliate link" tag as an FTC-style disclosure. Unapproved programs render
// as ordinary outbound links with no badge. Keep data-affiliate so links can
// be found with: grep -r 'data-affiliate' src
const approved = new Set([
  'innago',
  'smartmove',
]);
const { id, href, text } = Astro.props;
const isApproved = approved.has(id);
---
<a href={href} data-affiliate={id} rel={isApproved ? 'sponsored nofollow noopener' : 'noopener'} target="_blank">{text}</a>{isApproved && <span class="aff-tag" title="Affiliate link: we may earn a commission">affiliate link</span>}

---
const { title, description, updated = '2026-11-18', schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteName = 'Screening Atlas';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="impact-site-verification" value="f3eba38d-519e-47c3-a96d-78adf4f495a7" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <meta name="robots" content="index, follow" />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <style is:global>
    :root{--ink:#1b1f24;--muted:#5b6470;--line:#e3e6ea;--brand:#1f4e79;--bg:#fbfcfd;--warn:#8a5a00;--warnbg:#fff4dc}
    *{box-sizing:border-box}
    body{margin:0;font:17px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;color:var(--ink);background:var(--bg)}
    header.site,footer.site{border-bottom:1px solid var(--line);background:#fff}
    footer.site{border-top:1px solid var(--line);border-bottom:0;margin-top:4rem;font-size:14px;color:var(--muted)}
    .wrap{max-width:860px;margin:0 auto;padding:0 20px}
    header.site .wrap{display:flex;gap:1rem;align-items:center;justify-content:space-between;padding:14px 20px;flex-wrap:wrap}
    header.site a.brand{display:flex;align-items:center;line-height:0;text-decoration:none}
    header.site a.brand img{height:32px;width:auto;display:block}
    footer.site .publisher{margin:0 0 0.85rem}
    footer.site .publisher img{height:22px;width:auto;display:block}
    nav a{color:var(--ink);margin-left:1rem;text-decoration:none;font-size:15px}
    nav a:hover{color:var(--brand)}
    main{padding:2rem 0}
    h1{font-size:2rem;line-height:1.25;margin:.2em 0 .4em}
    h2{font-size:1.4rem;margin-top:2.2rem}
    a{color:var(--brand)}
    .lede{font-size:1.1rem;color:#333}
    .meta{color:var(--muted);font-size:14px}
    a.src{font-size:12px;vertical-align:super;text-decoration:none;margin-left:2px;white-space:nowrap}
    .aff-tag{font-size:11px;color:var(--muted);border:1px dashed #b9c0c8;border-radius:4px;padding:0 5px;margin-left:5px;white-space:nowrap}
    .note{background:#f1f5f9;border-left:4px solid var(--brand);padding:12px 16px;border-radius:4px;margin:1.2rem 0}
    .warnbox{background:var(--warnbg);border-left:4px solid #e0a100;padding:12px 16px;border-radius:4px;margin:1.2rem 0}
    .tablewrap{overflow-x:auto;margin:1rem 0}
    table{border-collapse:collapse;width:100%;font-size:15px;background:#fff}
    th,td{border:1px solid var(--line);padding:8px 10px;vertical-align:top;text-align:left}
    th{background:#f3f5f8}
    .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin:1.2rem 0}
    .card{background:#fff;border:1px solid var(--line);border-radius:8px;padding:16px}
    .card h3{margin:0 0 .4rem;font-size:1.05rem}
    .card p{margin:0;color:#333;font-size:15px}
    blockquote{margin:1rem 0;padding:.6rem 1rem;border-left:4px solid var(--line);color:#333;background:#fff}
    code{background:#eef1f4;padding:1px 4px;border-radius:3px;font-size:.92em}
  </style>
</head>
<body>
  <header class="site"><div class="wrap">
    <a class="brand" href="/"><img src="/logo.svg" alt="Screening Atlas" width="171" height="32" /></a>
    <nav>
      <a href="/application-fee-caps-by-state/">Fee caps</a>
      <a href="/tenant-screening-report-comparison/">Report comparison</a>
      <a href="/about/">About</a>
    </nav>
  </div></header>
  <main><div class="wrap">
    <slot />
    <p class="meta" style="margin-top:3rem">Last checked: {updated}. General information, not legal advice. Laws and provider pages change; follow the source links before relying on anything here.</p>
  </div></main>
  <footer class="site"><div class="wrap" style="padding:20px">
    <p class="publisher"><img src="/atlas-guides.svg" alt="Atlas Guides" width="77" height="22" /></p>
    <p>Screening Atlas: tenant screening rules and report coverage, state by state, with a source link on every claim.</p>
    <p><a href="/about/">About &amp; method</a> · <a href="/contact/">Contact</a> · <a href="/affiliate-disclosure/">Affiliate disclosure</a> · <a href="/privacy/">Privacy</a> · <a href="/sitemap.xml">Sitemap</a></p>
  </div></footer>
</body>
</html>

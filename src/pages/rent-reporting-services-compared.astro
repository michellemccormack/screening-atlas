const title = 'Rent Reporting to Credit Bureaus: TurboTenant, RentRedi, Avail and Innago Compared';
const description = 'Which landlord platforms report on-time rent to TransUnion, Experian and Equifax, what it costs, who pays, whether past months count, and California\'s rule requiring larger landlords to offer rent reporting. From each provider\'s own pages and Civil Code 1954.07.';

---
import Base from '../layouts/Base.astro';
import Src from '../components/Src.astro';
import Unverified from '../components/Unverified.astro';
const S = {
  smPrice: 'https://www.mysmartmove.com/pricing',
  ttHelpCost: 'https://support.turbotenant.com/en/articles/6362365-what-s-the-difference-between-a-rental-application-and-a-screening-report',
  ttPricing: 'https://www.turbotenant.com/pricing/',
  rrPrice: 'https://rentredi.com/pricing/',
  rentec: 'https://www.rentecdirect.com/pricing-transparency',
  rp: 'https://rentprep.com/guide/packages-pricing/',
};
const updated = '2026-11-21';
const title = 'Tenant Screening Cost Calculator: Landlord Pays vs. Applicant Pays';
const description = 'Work out what tenant screening costs you per vacancy and per year if you pay, versus what each applicant pays if they do, using the published prices for SmartMove, TurboTenant, RentRedi, Rentec Direct and RentPrep. Prices checked against each provider page.';
const schema = {"@context":"https://schema.org","@type":"WebApplication","name":title,"description":description,"applicationCategory":"FinanceApplication","dateModified":updated};
---
<Base title={title} description={description} updated={updated} schema={schema}>
  <h1>{title}</h1>
  <p class="lede">"Should I pay for screening or pass it to the applicant?" The answer is mostly arithmetic: how many people you screen per vacancy, how many vacancies you have a year, and which package you use. This calculator does that arithmetic with the prices each provider publishes. It runs in your browser and sends nothing anywhere.</p>

  <div class="warnbox"><strong>Check the law first.</strong> Some states cap or ban applicant-paid screening fees, and some make you waive the fee when the applicant brings a recent report. See <a href="/application-fee-caps-by-state/">application fee caps by state</a> and <a href="/reusable-tenant-screening-reports-by-state/">reusable reports by state</a>. Some providers also decide who can pay (see the table below).</div>

  <h2>Calculator</h2>
  <form id="calc" class="card" style="display:grid;gap:12px;max-width:620px" onsubmit="return false">
    <label>Provider and package<br/>
      <select id="pkg" style="width:100%;padding:6px"></select>
    </label>
    <label><input type="checkbox" id="income" /> Add income verification (where the provider offers it as an add-on)</label>
    <label>Applicants you screen per vacancy<br/><input id="per" type="number" min="1" step="1" value="3" style="width:120px;padding:6px" /></label>
    <label>Vacancies per year<br/><input id="vac" type="number" min="0" step="1" value="1" style="width:120px;padding:6px" /></label>
    <label>Sales tax rate, if your provider adds it (%)<br/><input id="tax" type="number" min="0" step="0.01" value="0" style="width:120px;padding:6px" /></label>
    <label>Your state's applicant fee cap, if any ($ per applicant, leave blank if none or unsure)<br/><input id="cap" type="number" min="0" step="0.01" style="width:120px;padding:6px" /></label>
  </form>
  <div id="out" class="note" aria-live="polite">Pick a package to see the totals.</div>
  <noscript><p class="warnbox">The calculator needs JavaScript. The price table below has the same numbers.</p></noscript>

  <h2>The prices the calculator uses</h2>
  <p>All prices were checked on each provider's own page on November 21, 2026. Monthly software subscriptions are not included.</p>
  <div class="tablewrap"><table>
    <thead><tr><th>Provider / package</th><th>Price per applicant</th><th>Income add-on</th><th>Who can pay</th></tr></thead>
    <tbody>
      <tr><td>SmartMove SmartCheck Basic / Plus / Premium</td><td>$25 / $42 / $49, plus tax where applicable <Src href={S.smPrice} /></td><td>$11 <Src href={S.smPrice} /></td><td>Landlord or applicant, "where permitted" <Src href={S.smPrice} /></td></tr>
      <tr><td>TurboTenant (Free plan / Essentials or Pro)</td><td>$55 / $45 <Src href={S.ttHelpCost} /></td><td>Income verification is listed as a plan feature, not a per-applicant add-on <Src href={S.ttPricing} /></td><td>Renter typically pays; landlord can choose to cover it <Src href={S.ttHelpCost} /></td></tr>
      <tr><td>RentRedi (credit + criminal + eviction / with Plaid income verification)</td><td>$39.99 / $49.99 <Src href={S.rrPrice} /></td><td>Included in the $49.99 tier</td><td>Tenant-paid <Src href={S.rrPrice} /></td></tr>
      <tr><td>Rentec Direct Basic / Enhanced / Premium (Starter plan)</td><td>$14.95 / $20.95 / $29.45 <Src href={S.rentec} /></td><td>Not listed</td><td>Not stated on the pricing page <Unverified /></td></tr>
      <tr><td>Rentec Direct Basic / Enhanced / Premium (Pro &amp; PM plans)</td><td>$10 / $13 / $18 <Src href={S.rentec} /></td><td>Not listed</td><td>Not stated on the pricing page <Unverified /></td></tr>
      <tr><td>RentPrep Credit Report Only / Full Background Check Only / Complete</td><td>$29 / $29 / $49 <Src href={S.rp} /></td><td>$10 (bank-based) or $15 (income &amp; employment) <Src href={S.rp} /></td><td>Credit-only and Complete: landlord or tenant. Background-only: landlord pays only <Src href={S.rp} /></td></tr>
    </tbody>
  </table></div>
  <p class="meta">Rentec Direct's packages differ in content: Basic is criminal, sex offender and SSN validation; Enhanced adds eviction search; only Premium adds the TransUnion credit report <Src href={S.rentec} />. RentPrep says its reports "are now delivered by Stessa" <Src href={S.rp} />. For what each package contains and where records may be missing, see <a href="/tenant-screening-report-comparison/">the report comparison</a>.</p>

  <h2>How to read the result</h2>
  <ul>
    <li><strong>Landlord pays:</strong> your cost scales with how many people you screen. Screening only your top one or two applicants after a showing and an application review keeps it low.</li>
    <li><strong>Applicant pays:</strong> your cost is zero, but each applicant pays the full price, and the ones you turn down pay for nothing. Where a state caps the fee below the provider's price, the calculator flags it.</li>
    <li><strong>Platform-fixed pricing:</strong> on TurboTenant the applicant price depends on <em>your</em> plan ($55 on Free, $45 on Essentials/Pro) <Src href={S.ttHelpCost} />, so a paid plan lowers what applicants pay.</li>
  </ul>

  <h2>Related</h2>
  <ul>
    <li><a href="/rent-collection-app-fees/">Rent collection app fees compared</a></li>
    <li><a href="/alternatives-to-zillow-rental-manager-screening/">Alternatives to Zillow Rental Manager screening</a></li>
    <li><a href="/">All Screening Atlas guides</a></li>
  </ul>

  <script is:inline>
  (function(){
    var P=[
      {id:'sm-basic',n:'SmartMove SmartCheck Basic',p:25,inc:11,tax:true,who:'either'},
      {id:'sm-plus',n:'SmartMove SmartCheck Plus',p:42,inc:11,tax:true,who:'either'},
      {id:'sm-prem',n:'SmartMove SmartCheck Premium',p:49,inc:11,tax:true,who:'either'},
      {id:'tt-free',n:'TurboTenant (Free plan)',p:55,inc:null,tax:false,who:'either'},
      {id:'tt-paid',n:'TurboTenant (Essentials or Pro plan)',p:45,inc:null,tax:false,who:'either'},
      {id:'rr-std',n:'RentRedi credit + criminal + eviction',p:39.99,inc:10,tax:false,who:'applicant',incNote:'RentRedi sells income verification as its $49.99 tier, so the add-on here is the $10 difference.'},
      {id:'rt-s-basic',n:'Rentec Direct Basic (Starter)',p:14.95,inc:null,tax:false,who:'unknown'},
      {id:'rt-s-enh',n:'Rentec Direct Enhanced (Starter)',p:20.95,inc:null,tax:false,who:'unknown'},
      {id:'rt-s-prem',n:'Rentec Direct Premium (Starter)',p:29.45,inc:null,tax:false,who:'unknown'},
      {id:'rt-p-basic',n:'Rentec Direct Basic (Pro/PM)',p:10,inc:null,tax:false,who:'unknown'},
      {id:'rt-p-enh',n:'Rentec Direct Enhanced (Pro/PM)',p:13,inc:null,tax:false,who:'unknown'},
      {id:'rt-p-prem',n:'Rentec Direct Premium (Pro/PM)',p:18,inc:null,tax:false,who:'unknown'},
      {id:'rp-credit',n:'RentPrep Credit Report Only',p:29,inc:10,tax:false,who:'either'},
      {id:'rp-bg',n:'RentPrep Full Background Check Only',p:29,inc:10,tax:false,who:'landlord'},
      {id:'rp-comp',n:'RentPrep Complete Screening Package',p:49,inc:10,tax:false,who:'either'}
    ];
    var $=function(i){return document.getElementById(i)};
    var sel=$('pkg');
    P.forEach(function(x){var o=document.createElement('option');o.value=x.id;o.textContent=x.n+' ($'+x.p.toFixed(2)+')';sel.appendChild(o);});
    function money(v){return '$'+v.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g,',');}
    function calc(){
      var x=P.filter(function(y){return y.id===sel.value})[0];
      var per=Math.max(0,parseInt($('per').value||'0',10));
      var vac=Math.max(0,parseInt($('vac').value||'0',10));
      var tax=Math.max(0,parseFloat($('tax').value||'0'))/100;
      var capRaw=$('cap').value; var cap=capRaw===''?null:parseFloat(capRaw);
      var unit=x.p; var notes=[];
      if($('income').checked){ if(x.inc===null){notes.push('This package has no per-applicant income add-on listed, so none was added.');} else {unit+=x.inc; if(x.incNote) notes.push(x.incNote);} }
      if(x.tax&&tax>0){unit=unit*(1+tax);} else if(!x.tax&&tax>0){notes.push('Tax was not applied: this provider\'s page doesn\'t say it adds tax.');}
      var perVac=unit*per, perYear=perVac*vac;
      var h='<strong>'+x.n+'</strong>: '+money(unit)+' per applicant.<br/>';
      if(x.who==='applicant'){h+='<strong>Landlord pays:</strong> not offered for this package (tenant-paid).<br/>';}
      else {h+='<strong>If you pay:</strong> '+money(perVac)+' per vacancy, '+money(perYear)+' per year.<br/>';}
      if(x.who==='landlord'){h+='<strong>If applicants pay:</strong> not offered for this package (landlord pays only).';}
      else {h+='<strong>If applicants pay:</strong> $0 to you; each applicant pays '+money(unit)+', and the '+Math.max(0,per-1)+' you don\'t pick per vacancy pay '+money(unit*Math.max(0,per-1))+' between them.';
        if(cap!==null&&!isNaN(cap)&&unit>cap){h+='<br/><strong>Over your cap:</strong> the price is '+money(unit-cap)+' above the '+money(cap)+' cap you entered. You may need to pay the difference or use a cheaper package.';}}
      if(x.who==='unknown'){notes.push('Rentec Direct\'s pricing page doesn\'t say whether applicants can pay. Confirm with Rentec before planning on applicant-paid.');}
      if(notes.length) h+='<br/><span class="meta">'+notes.join(' ')+'</span>';
      $('out').innerHTML=h;
    }
    ['pkg','income','per','vac','tax','cap'].forEach(function(i){$(i).addEventListener('input',calc);$(i).addEventListener('change',calc);});
    calc();
  })();
  </script>
</Base>

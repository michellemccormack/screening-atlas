---
import Base from '../../layouts/Base.astro';
const title = 'Thank you for your purchase';
const description = 'Download your Landlord Tenant Screening Kit.';
---
<Base title={title} description={description} updated="2026-11-24" noindex={true}>
  <h1>Thank you for your purchase</h1>
  <p class="lede">Your Landlord Tenant Screening Kit is ready on the confirmation page Stripe showed you after you paid.</p>
  <p>Use the download link on that page to get the ZIP. Please keep that link to yourself.</p>
  <p>If you already closed that tab, email us from the <a href="/contact/">contact page</a> with the time of your purchase and we will send the download link.</p>
  <p>The ZIP includes the 16-page PDF, 5 editable Word templates and an Excel decision log.</p>
  <p>If the kit isn&#x27;t what you needed, there is a 14-day money-back guarantee, no questions asked. Email us from the <a href="/contact/">contact page</a>.</p>
  <p><a href="/kit/">Back to the kit page</a></p>
</Base>
